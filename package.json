{
  "name": "lexatech-ecosystem",
  "private": true,
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:push": "npm run db:push:core && npm run db:push:compliance",
    "db:push:core": "node --env-file=.env node_modules/drizzle-kit/bin.cjs push --config modules/core/drizzle.config.ts",
    "db:push:compliance": "node --env-file=.env node_modules/drizzle-kit/bin.cjs push --config modules/compliance/drizzle.config.ts"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.8",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },

  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/*"
  ]
}
