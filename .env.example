# Local development uses a persistent embedded PostgreSQL-compatible database.
PGLITE_DATA_DIR=../../.data/lexatech

# Production: set DATABASE_URL to use an external PostgreSQL server instead.
# DATABASE_URL=postgresql://lexatech:change-me@localhost:5432/lexatech

# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters

# Browser origin allowed to make state-changing API requests.
APP_ORIGIN=http://localhost:3000

# API binding and Next.js proxy destination.
PORT=3002
API_ORIGIN=http://localhost:3002

# Local testing only. Never enable this in production.
ENABLE_TEST_ACCOUNT=false
